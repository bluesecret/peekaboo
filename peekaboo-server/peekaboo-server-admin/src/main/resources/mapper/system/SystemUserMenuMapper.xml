<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.wangk.peekaboo.server.admin.repository.mapper.SystemRoleMenuMapper">

        <resultMap id="selectRoleMenuListMap" type="io.wangk.peekaboo.server.admin.api.dto.bo.SystemRoleMenuDTO">
                <id column="id" property="id"/>
                <result column="parent_id" property="parentId"/>
                <result column="component" property="component"/>
                <result column="path" property="path"/>
                <result column="component_name" property="componentName"/>
                <result column="permission" property="permission"/>
                <association property="meteInfo" javaType="io.wangk.peekaboo.server.admin.api.dto.bo.MeteInfo">
                        <result column="name" property="name"/>
                        <result column="visible" property="visible"/>
                        <result column="type" property="type"/>
                        <result column="icon" property="icon"/>
                        <result column="keep_alive" property="keepAlive"/>
                </association>
        </resultMap>
   <select id="selectRoleMenuList" resultMap="selectRoleMenuListMap">
           SELECT  DISTINCT m.id,
           rm.role_id,
           rm.menu_id,
           m.name ,
           m.path,
           m.icon,
           m.sort,
           m.parent_id,
           m.permission,
           m.visible,
           m.component_name,
           m.component,
           m.status,
           m.type,
           m.keep_alive,
           m.create_time
           FROM system_menu m
           LEFT JOIN system_role_menu rm ON rm.menu_id = m.id
           LEFT JOIN system_role r ON rm.role_id = r.id
           WHERE rm.role_id IN
           <foreach item="roleId"  collection="roleIds" open="(" separator="," close=")">
               #{roleId}
           </foreach>
           and m.status = 0 and m.deleted=0
           order by m.sort ,m.create_time desc
           </select>
        <select id="selectRoleMenuPermission" resultType="io.wangk.peekaboo.server.admin.api.dto.bo.SystemRolePermissionDTO">
                SELECT  DISTINCT m.id,
                rm.role_id,
                rm.menu_id,
                m.permission
                FROM system_menu m
                LEFT JOIN system_role_menu rm ON rm.menu_id = m.id
                LEFT JOIN system_role r ON rm.role_id = r.id
                WHERE m.type= 2 and rm.role_id IN
                <foreach item="roleId"  collection="roleIds" open="(" separator="," close=")">
                        #{roleId}
                </foreach>
        </select>


        <select id="getBindMenu" resultType="io.wangk.peekaboo.server.admin.api.dto.vo.SystemMenuView">
                select rm.menu_id as id
                       from system_role_menu rm
               where rm.role_id = #{id}
        </select>
</mapper>